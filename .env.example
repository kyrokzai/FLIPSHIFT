# FORMIQ TALENT AGENT — пример настроек окружения.
# Скопируйте в .env.local и заполните. Файлы .env* не попадают в Git.

# Движок разбора запросов работодателя:
#   rules     — встроенный разбор без обращения к внешней модели (по умолчанию, бесплатно)
#   anthropic — разбор уточняется моделью Claude (платный API, нужен ключ)
AI_PROVIDER=rules

# Ключ нужен только при AI_PROVIDER=anthropic. Никогда не коммитьте настоящий ключ.
ANTHROPIC_API_KEY=

# Модель для AI_PROVIDER=anthropic. По умолчанию claude-opus-5-5.
# Для экономии можно указать claude-sonnet-5-5 или claude-haiku-5-5.
AI_MODEL=

# Лимит публичных запросов к ИИ с одного IP-адреса в минуту.
INTAKE_RATE_LIMIT_PER_MINUTE=20
